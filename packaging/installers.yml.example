name: Build native installers

on:
  workflow_dispatch:
    inputs:
      draft_release:
        description: Create a draft release after every platform succeeds
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: installers-${{ github.ref }}
  cancel-in-progress: false

jobs:
  windows:
    runs-on: windows-2022
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - run: python -m pip install --only-binary=:all: -r requirements-build.lock
      - run: python tools/fetch_native.py
      - run: python -m unittest discover -s tests -v
      - run: python tools/build.py
      - run: python tools/frozen_checks.py dist/0.3.1/DeskBridge/DeskBridge.exe
      - run: python tests/service_snapshot.py dist/0.3.1/DeskBridge
      - run: python tools/package.py
      - shell: pwsh
        run: |
          ./tools/bootstrap-inno.ps1
          python tools/installers.py --iscc "$PWD/build/tools/inno/ISCC.exe"
          if ($LASTEXITCODE -ne 0) { throw 'Installer build failed' }
      - run: python tools/checksums.py
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: windows-x64
          if-no-files-found: error
          compression-level: 0
          path: |
            dist/DeskBridge-0.3.1-*.exe
            dist/DeskBridge-0.3.1-*.zip
            dist/SHA256SUMS-0.3.1-windows-x64.txt

  macos:
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: macos-15
            arch: arm64
          - runner: macos-15-intel
            arch: x86_64
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 35
    env:
      TMPDIR: ${{ github.workspace }}/build/tmp
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - run: python -c 'import tkinter; print(tkinter.TkVersion)'
      - run: mkdir -p build/tmp
      - run: python -m pip install --only-binary=:all: -r requirements-build.lock
      - run: python tools/fetch_native.py
      - run: python -m unittest discover -s tests -v
      - run: python tools/build.py
      - run: python tools/installers.py --native vendor/cache/deskflow-1.27.0-macos-${{ matrix.arch }}.dmg
      - run: python tools/frozen_checks.py dist/0.3.1/DeskBridge.app/Contents/MacOS/DeskBridge
      - run: python tools/checksums.py
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: macos-${{ matrix.arch }}
          if-no-files-found: error
          compression-level: 0
          path: |
            dist/DeskBridge-0.3.1-*.dmg
            dist/SHA256SUMS-0.3.1-macos-${{ matrix.arch }}.txt

  ubuntu:
    runs-on: ubuntu-26.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - name: Install build prerequisites
        run: |
          sudo apt-get update
          sudo apt-get install -y python3-venv python3-tk
          python3 -m venv .venv
          .venv/bin/python -m pip install --only-binary=:all: -r requirements-build.lock
      - run: .venv/bin/python tools/fetch_native.py
      - run: sudo apt-get install -y ./vendor/cache/deskflow-1.27.0-ubuntu-resolute-x86_64.deb
      - run: .venv/bin/python -m unittest discover -s tests -v
      - run: .venv/bin/python tools/build.py
      - run: .venv/bin/python tools/installers.py --native vendor/cache/deskflow-1.27.0-ubuntu-resolute-x86_64.deb
      - run: sudo apt-get install -y ./dist/DeskBridge-0.3.1-ubuntu-26.04-amd64.deb
      - run: .venv/bin/python tools/frozen_checks.py /opt/deskbridge/DeskBridge
      - run: .venv/bin/python tools/checksums.py
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: ubuntu-26.04-amd64
          if-no-files-found: error
          compression-level: 0
          path: |
            dist/DeskBridge-0.3.1-*.deb
            dist/SHA256SUMS-0.3.1-ubuntu-26.04-amd64.txt

  draft-release:
    if: inputs.draft_release && github.ref == 'refs/heads/main'
    needs: [windows, macos, ubuntu]
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          path: build/release
          merge-multiple: true
      - name: Draft release with installers and checksums
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          gh release create v0.3.1 build/release/* --draft --target "$GITHUB_SHA" --title 'DeskBridge 0.3.1' --notes-file docs/release-notes.md
